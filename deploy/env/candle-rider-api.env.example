# deploy/env/candle-rider-api.env
# Copy to candle-rider-api.env on the server (NOT committed to git — add the
# real file to .gitignore). Referenced by the systemd unit's EnvironmentFile.

PORT=3001
# 0.0.0.0 is required — Caddy reaches this via the Docker bridge gateway
# (host.docker.internal), not localhost. Port 3001 must be locked down at
# the ufw level to only accept the Docker bridge subnet + localhost.
HOST=0.0.0.0
CANDLE_RIDER_DB_PATH=/opt/candle-rider/server/data/candlerider.db
CLIENT_DIST_PATH=/opt/candle-rider/client/dist
